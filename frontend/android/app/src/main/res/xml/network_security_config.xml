<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config — restricts cleartext (HTTP) traffic to LAN ranges only.
    Public internet connections always use TLS; local XAMPP connections (admin hotspot)
    are allowed over HTTP since the admin LAN has no TLS certificate.
-->
<network-security-config>
    <!-- Public internet: TLS enforced (default — no cleartext) -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Private LAN ranges: allow HTTP for local XAMPP server -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.43.1</domain>
        <!-- Covers all 192.168.x.x hotspot addresses -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
